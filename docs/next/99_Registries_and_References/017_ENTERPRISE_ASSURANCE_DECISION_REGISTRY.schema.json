{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaep.example/schemas/enterprise-assurance-decision/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "version", "schemaVersion", "status", "reviewedAt", "authorityBoundary", "evidenceDepthLevels", "referenceDepthAssessments", "enterpriseConcernAssessments", "claimAssurance", "decisionProfileTemplate", "pilotDecisionDossier"],
  "properties": {
    "$schema": { "type": "string" }, "registryId": { "const": "GAEP-REG-017" }, "version": { "type": "string" }, "schemaVersion": { "type": "string" }, "status": { "const": "candidate-unaccepted" }, "reviewedAt": { "type": "string", "format": "date" }, "authorityBoundary": { "type": "string" },
    "evidenceDepthLevels": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/depth" } },
    "referenceDepthAssessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "enterpriseConcernAssessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/concern" } },
    "claimAssurance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "decisionProfileTemplate": { "type": "object", "additionalProperties": false, "required": ["profileState", "requiredInputs", "mandatoryGates", "comparisonCriteria", "weightingRules"], "properties": { "profileState": { "const": "organization-input-required" }, "requiredInputs": { "$ref": "#/$defs/stringArray" }, "mandatoryGates": { "$ref": "#/$defs/stringArray" }, "comparisonCriteria": { "$ref": "#/$defs/stringArray" }, "weightingRules": { "$ref": "#/$defs/stringArray" } } },
    "pilotDecisionDossier": { "type": "object", "additionalProperties": false, "required": ["recommendationState", "allowedRecommendationStates", "requiredSections", "currentDisposition"], "properties": { "recommendationState": { "type": "string" }, "allowedRecommendationStates": { "$ref": "#/$defs/stringArray" }, "requiredSections": { "$ref": "#/$defs/stringArray" }, "currentDisposition": { "type": "string" } } }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "depth": { "type": "object", "additionalProperties": false, "required": ["depthId", "label", "requiredEvidence", "permittedUses", "prohibitedUses"], "properties": { "depthId": { "type": "string", "pattern": "^ED[0-5]$" }, "label": { "type": "string" }, "requiredEvidence": { "$ref": "#/$defs/stringArray" }, "permittedUses": { "$ref": "#/$defs/stringArray" }, "prohibitedUses": { "$ref": "#/$defs/stringArray" } } },
    "reference": { "type": "object", "additionalProperties": false, "required": ["referenceId", "evidenceDepth", "reviewedCoverage", "currentGaepMapping", "implementationEvidence", "assuranceState", "residualGap", "adoptionConsequence"], "properties": { "referenceId": { "type": "string" }, "evidenceDepth": { "type": "string", "pattern": "^ED[0-5]$" }, "reviewedCoverage": { "type": "string" }, "currentGaepMapping": { "type": "string" }, "implementationEvidence": { "type": "string" }, "assuranceState": { "type": "string" }, "residualGap": { "type": "string" }, "adoptionConsequence": { "type": "string" } } },
    "concern": { "type": "object", "additionalProperties": false, "required": ["concernId", "requiredDecision", "referenceFamily", "minimumEvidenceDepth", "currentMapping", "implementationEvidence", "assuranceState", "residualGap", "adoptionConsequence"], "properties": { "concernId": { "type": "string" }, "requiredDecision": { "type": "string" }, "referenceFamily": { "$ref": "#/$defs/stringArray" }, "minimumEvidenceDepth": { "type": "string", "pattern": "^ED[0-5]$" }, "currentMapping": { "type": "string" }, "implementationEvidence": { "type": "string" }, "assuranceState": { "type": "string" }, "residualGap": { "type": "string" }, "adoptionConsequence": { "type": "string" } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claimId", "claim", "claimType", "scope", "status", "supportingContractIds", "repositoryEvidence", "tests", "runtimeEvidence", "limitations", "counterEvidence", "verificationDate", "independentReviewState", "permittedAudience", "prohibitedInterpretation"], "properties": { "claimId": { "type": "string" }, "claim": { "type": "string" }, "claimType": { "type": "string" }, "scope": { "type": "string" }, "status": { "enum": ["not-established", "design-mapped", "implemented-but-unverified", "test-verified", "runtime-verified", "independently-verified", "superseded"] }, "supportingContractIds": { "$ref": "#/$defs/stringArray" }, "repositoryEvidence": { "$ref": "#/$defs/stringArray" }, "tests": { "$ref": "#/$defs/stringArray" }, "runtimeEvidence": { "$ref": "#/$defs/stringArray" }, "limitations": { "$ref": "#/$defs/stringArray" }, "counterEvidence": { "$ref": "#/$defs/stringArray" }, "verificationDate": { "type": "string", "format": "date" }, "independentReviewState": { "type": "string" }, "permittedAudience": { "$ref": "#/$defs/stringArray" }, "prohibitedInterpretation": { "type": "string" } } }
  }
}
