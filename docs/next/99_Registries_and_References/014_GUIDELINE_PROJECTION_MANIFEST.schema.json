{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaep.example/schemas/guideline-projection-manifest-1.1.0.json",
  "title": "GAEP Guideline Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "registryId", "version", "status", "projectionStewardRoleId", "approval", "generation",
    "canonicalSources", "audienceLayers", "requiredSections", "requiredVisuals", "lifecycleSegments", "lifecycleNodes",
    "transitionRoadmap", "stakeholderRequirements", "proposedCanonicalGaps", "sourceLifecycle", "statePolicy", "commandSurface"
  ],
  "properties": {
    "schemaId": { "const": "https://gaep.example/schemas/guideline-projection-manifest-1.1.0.json" },
    "schemaVersion": { "const": "1.1.0" },
    "registryId": { "const": "GAEP-REG-014" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "const": "proposed" },
    "projectionStewardRoleId": { "const": "product-leadership" },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "approvedBy", "approvedAt", "publicationState"],
      "properties": {
        "state": { "const": "not-approved" },
        "approvedBy": { "type": "array", "maxItems": 0 },
        "approvedAt": { "type": "null" },
        "publicationState": { "const": "not-published" }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["templatePath", "outputPath", "decisionSupportOutputPath", "rendererPath", "timestampPolicy"],
      "properties": {
        "templatePath": { "$ref": "#/$defs/repositoryPath" },
        "outputPath": { "const": "apps/vscode/media/GAEP_GUIDE.md" },
        "decisionSupportOutputPath": { "const": "apps/vscode/media/GAEP_MARKET_DECISION_GUIDE.md" },
        "rendererPath": { "const": "scripts/render_guideline.mjs" },
        "timestampPolicy": { "const": "none-deterministic" }
      }
    },
    "canonicalSources": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceBinding" } },
    "audienceLayers": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/audienceLayer" } },
    "requiredSections": { "type": "array", "minItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/section" } },
    "requiredVisuals": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/visual" } },
    "lifecycleSegments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lifecycleSegment" } },
    "lifecycleNodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lifecycleNode" } },
    "transitionRoadmap": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/transition" } },
    "stakeholderRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stakeholderRequirement" } },
    "proposedCanonicalGaps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/proposedGap" } },
    "sourceLifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["concepts", "events", "supersessionRule"],
      "properties": {
        "concepts": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceConcept" } },
        "events": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceEvent" } },
        "supersessionRule": { "type": "string", "minLength": 40 }
      }
    },
    "statePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["displayPriority", "labels", "unknownRule", "colorRule"],
      "properties": {
        "displayPriority": { "const": ["unknown-not-assessed", "planned-deferred-coming-soon", "candidate-proposed", "partial", "implemented-awaiting-product-owner-acceptance", "implemented-and-automated-tested"] },
        "labels": {
          "type": "object", "additionalProperties": false,
          "required": ["unknown-not-assessed", "planned-deferred-coming-soon", "candidate-proposed", "partial", "implemented-awaiting-product-owner-acceptance", "implemented-and-automated-tested"],
          "properties": {
            "unknown-not-assessed": { "const": "[UN] Unknown / not assessed" },
            "planned-deferred-coming-soon": { "const": "[PD] Planned / deferred" },
            "candidate-proposed": { "const": "[CP] Candidate / proposed" },
            "partial": { "const": "[PT] Partial" },
            "implemented-awaiting-product-owner-acceptance": { "const": "[IA] Implemented; awaiting independent P03 review" },
            "implemented-and-automated-tested": { "const": "[IT] Implemented and automated-tested" }
          }
        },
        "unknownRule": { "const": "Unknown means not assessed or not established; it never means No." },
        "colorRule": { "const": "Every state uses text and an accessible marker; color is supplementary only." }
      }
    },
    "commandSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["extensionCommandIds", "chatCommands"],
      "properties": {
        "extensionCommandIds": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^gaep\\.[A-Za-z][A-Za-z0-9.]+$" } },
        "chatCommands": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+$" } }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "repositoryPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpointId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "nodeId": { "type": "string", "pattern": "^lifecycle-[a-z0-9-]+$" },
    "capabilityId": { "type": "string", "pattern": "^GAEP-CAP-[0-9]{3}$" },
    "gapId": { "type": "string", "pattern": "^GAEP-P03-GAP-[0-9]{3}$" },
    "maturityState": { "enum": ["unknown-not-assessed", "planned-deferred-coming-soon", "candidate-proposed", "partial", "implemented-awaiting-product-owner-acceptance", "implemented-and-automated-tested"] },
    "sourceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "identity", "version", "schemaVersion", "sha256"],
      "properties": {
        "kind": { "enum": ["methodology-catalog", "market-registry", "terminology-index", "runtime-presentation-contract", "runtime-contract-schema", "responsibility-competency-registry", "enterprise-assurance-registry", "extension-package"] },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "schemaVersion": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "audienceLayer": {
      "type": "object", "additionalProperties": false,
      "required": ["layerId", "title", "primaryAudience", "readingTimeMinutes"],
      "properties": {
        "layerId": { "enum": ["executive-orientation", "quick-start", "practitioner-guide", "methodology-appendix"] },
        "title": { "type": "string", "minLength": 1 },
        "primaryAudience": { "type": "string", "minLength": 1 },
        "readingTimeMinutes": { "type": "integer", "minimum": 2, "maximum": 30 }
      }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["sectionId", "heading", "layerId", "contentMode"],
      "properties": {
        "sectionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "heading": { "type": "string", "minLength": 3 },
        "layerId": { "enum": ["executive-orientation", "quick-start", "practitioner-guide", "methodology-appendix"] },
        "contentMode": { "enum": ["hand-authored-narrative", "generated-canonical-facts", "hybrid"] }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["visualId", "title", "sectionId", "direction", "purpose"],
      "properties": {
        "visualId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 3 },
        "sectionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "direction": { "enum": ["TD", "TB"] },
        "purpose": { "type": "string", "minLength": 10 }
      }
    },
    "lifecycleSegment": {
      "type": "object", "additionalProperties": false,
      "required": ["segmentId", "order", "visualId", "title"],
      "properties": {
        "segmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "visualId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 3 }
      }
    },
    "lifecycleNode": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "order", "segmentId", "title", "targetIntent", "capabilityIds", "proposedGapIds"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "order": { "type": "integer", "minimum": 1 },
        "segmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 3 },
        "targetIntent": { "type": "string", "minLength": 20 },
        "capabilityIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityId" } },
        "proposedGapIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/gapId" } }
      },
      "anyOf": [
        { "properties": { "capabilityIds": { "type": "array", "minItems": 1 } } },
        { "properties": { "proposedGapIds": { "type": "array", "minItems": 1 } } }
      ]
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["currentCheckpointId", "targetNodeIds", "transitionType", "currentMaturity", "targetIntent", "dependency", "implementationStatus", "acceptanceDecision", "migrationState"],
      "properties": {
        "currentCheckpointId": { "$ref": "#/$defs/checkpointId" },
        "targetNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nodeId" } },
        "transitionType": { "enum": ["retained", "renamed", "expanded", "split", "merged", "deprecated", "newly-planned", "replaced-by-tool-neutral-abstraction"] },
        "currentMaturity": { "$ref": "#/$defs/maturityState" },
        "targetIntent": { "type": "string", "minLength": 15 },
        "dependency": { "type": "string", "minLength": 3 },
        "implementationStatus": { "enum": ["current-runtime-implemented-target-partial", "current-runtime-implemented-target-planned", "target-only-planned", "unresolved"] },
        "acceptanceDecision": { "enum": ["accepted", "unresolved", "rejected"] },
        "migrationState": { "enum": ["implemented", "planned", "unresolved"] }
      }
    },
    "stakeholderRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirementId", "title", "targetNodeIds", "currentCheckpointIds", "canonicalSourceIds", "currentMaturity", "futureDisposition", "gapOrDecision"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^GAEP-P03-REQ-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 3 },
        "targetNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nodeId" } },
        "currentCheckpointIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/checkpointId" } },
        "canonicalSourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GAEP-(?:CAP|CONCERN|REG)-[0-9]{3}$" } },
        "currentMaturity": { "$ref": "#/$defs/maturityState" },
        "futureDisposition": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "gapOrDecision": { "type": "string", "minLength": 10 }
      }
    },
    "proposedGap": {
      "type": "object", "additionalProperties": false,
      "required": ["gapId", "title", "status", "requiredCanonicalCorrection", "scopedImpacts"],
      "properties": {
        "gapId": { "$ref": "#/$defs/gapId" },
        "title": { "type": "string", "minLength": 3 },
        "status": { "const": "proposed-unaccepted" },
        "requiredCanonicalCorrection": { "type": "string", "minLength": 20 },
        "scopedImpacts": {
          "type": "object", "additionalProperties": false,
          "required": ["p03ProjectionAcceptance", "targetCapabilityActivation", "currentRuntimeAvailability", "responsibleRoadmapItems", "prerequisite", "executableState"],
          "properties": {
            "p03ProjectionAcceptance": { "const": "non-blocking-when-honestly-projected" },
            "targetCapabilityActivation": { "type": "string", "minLength": 10 },
            "currentRuntimeAvailability": { "type": "string", "minLength": 10 },
            "responsibleRoadmapItems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
            "prerequisite": { "type": "string", "minLength": 10 },
            "executableState": { "const": "proposed-non-executable" }
          }
        }
      }
    },
    "sourceConcept": {
      "type": "object", "additionalProperties": false,
      "required": ["conceptId", "label", "meaning", "reviewBoundary", "adoptBoundary", "revisionRule", "doesNotAuthorize"],
      "properties": {
        "conceptId": { "enum": ["source-intake", "source-baseline", "source-provenance"] },
        "label": { "type": "string", "minLength": 3 },
        "meaning": { "type": "string", "minLength": 20 },
        "reviewBoundary": { "type": "string", "minLength": 20 },
        "adoptBoundary": { "type": "string", "minLength": 20 },
        "revisionRule": { "type": "string", "minLength": 20 },
        "doesNotAuthorize": { "type": "string", "minLength": 20 }
      }
    },
    "sourceEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "label", "runtimeClassification", "userSees", "userAction", "recordEffect", "baselineReview", "provenanceReview", "downstreamRevalidation", "safeWorkaround", "doesNotAuthorize"],
      "properties": {
        "eventId": { "enum": ["source-added", "source-changed", "source-removed-excluded", "source-superseded", "source-unavailable"] },
        "label": { "type": "string", "minLength": 3 },
        "runtimeClassification": { "enum": ["implemented-and-verified", "implemented-awaiting-product-owner-acceptance", "partial", "planned-deferred", "unsupported-unavailable", "unknown"] },
        "userSees": { "type": "string", "minLength": 20 },
        "userAction": { "type": "string", "minLength": 20 },
        "recordEffect": { "type": "string", "minLength": 20 },
        "baselineReview": { "type": "string", "minLength": 10 },
        "provenanceReview": { "type": "string", "minLength": 10 },
        "downstreamRevalidation": { "type": "string", "minLength": 10 },
        "safeWorkaround": { "type": "string", "minLength": 10 },
        "doesNotAuthorize": { "type": "string", "minLength": 20 }
      }
    }
  }
}
