{
  "name": "gaep-vscode",
  "displayName": "GAEP",
  "description": "Governed product design and multi-agent execution for VS Code.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "gaep",
  "license": "UNLICENSED",
  "files": [
    "dist/extension.cjs",
    "media/gaep.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["gaep", "codex", "claude", "agent", "product design", "governance"],
  "main": "dist/extension.cjs",
  "activationEvents": [
    "onView:gaep.overview",
    "onView:gaep.agent",
    "onView:gaep.governance",
    "onCommand:gaep.initializeProduct",
    "onCommand:gaep.selectWorkspaceRoot",
    "onCommand:gaep.selectAgent",
    "onCommand:gaep.createInitiative",
    "onCommand:gaep.changeInitiativeState",
    "onCommand:gaep.prepareRun",
    "onCommand:gaep.verifyAudit",
    "onCommand:gaep.showDiagnostics",
    "onCommand:gaep.retryRecovery",
    "onCommand:gaep.manageWorkspaceTrust",
    "onCommand:gaep.refresh"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "GAEP shows a trust stop line but does not inspect agent executables, mutate Product state, recover runs, or start processes until the workspace is trusted.",
      "restrictedConfigurations": [
        "gaep.codex.executable",
        "gaep.claude.executable"
      ]
    }
  },
  "contributes": {
    "commands": [
      { "command": "gaep.initializeProduct", "title": "GAEP: Initialize Product" },
      { "command": "gaep.selectWorkspaceRoot", "title": "GAEP: Select Product Root" },
      { "command": "gaep.selectAgent", "title": "GAEP: Select Agent and Model" },
      { "command": "gaep.createInitiative", "title": "GAEP: Create Initiative" },
      { "command": "gaep.changeInitiativeState", "title": "GAEP: Change Initiative State" },
      { "command": "gaep.prepareRun", "title": "GAEP: Create Charter and Start Run" },
      { "command": "gaep.verifyAudit", "title": "GAEP: Verify Audit Chain" },
      { "command": "gaep.showDiagnostics", "title": "GAEP: Show Diagnostics" },
      { "command": "gaep.retryRecovery", "title": "GAEP: Retry Recovery" },
      { "command": "gaep.manageWorkspaceTrust", "title": "GAEP: Manage Workspace Trust" },
      { "command": "gaep.refresh", "title": "GAEP: Refresh" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gaep",
          "title": "GAEP",
          "icon": "media/gaep.svg"
        }
      ]
    },
    "views": {
      "gaep": [
        { "id": "gaep.overview", "name": "Product" },
        { "id": "gaep.agent", "name": "Agent" },
        { "id": "gaep.governance", "name": "Governance" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "gaep.refresh", "when": "view =~ /gaep\\./", "group": "navigation" },
        { "command": "gaep.selectWorkspaceRoot", "when": "view =~ /gaep\\./", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "GAEP",
      "properties": {
        "gaep.codex.executable": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Machine-scoped Codex executable name or absolute path. Workspace overrides are ignored, and GAEP never reads Codex credentials."
        },
        "gaep.claude.executable": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "Machine-scoped Claude Code executable name or absolute path. Workspace overrides are ignored, and GAEP never reads Claude credentials."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository -o dist/gaep-vscode.vsix",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@gaep/adapter-claude": "0.1.0",
    "@gaep/adapter-codex": "0.1.0",
    "@gaep/agent-sdk": "0.1.0",
    "@gaep/contracts": "0.1.0",
    "@gaep/engine": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.11"
  }
}
