<idea-plugin>
    <id>dev.gaep.productstudio</id>
    <name>GAEP</name>
    <vendor>GAEP</vendor>
    <description>Governed product design and multi-agent execution for Rider.</description>
    <depends>com.intellij.modules.rider</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationInitializedListener implementation="dev.gaep.rider.GaepApplicationInitializedListener" />
        <toolWindow id="GAEP"
                    anchor="right"
                    factoryClass="dev.gaep.rider.GaepToolWindowFactory"
                    canCloseContents="false" />
    </extensions>
</idea-plugin>
