<Project Sdk="Microsoft.NET.Sdk">
  <!-- GAEP-P0-CS02 — unit tests for the pure Visual Studio request/validation logic (GaepRequests).
       Cross-platform (net8.0); run in the Windows lane via `dotnet test`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gaep.HostClient\Gaep.HostClient.csproj" />
  </ItemGroup>
</Project>
