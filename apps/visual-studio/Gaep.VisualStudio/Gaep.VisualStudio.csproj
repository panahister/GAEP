<Project Sdk="Microsoft.NET.Sdk">
  <!-- GAEP-P0-CS02 — out-of-process Visual Studio extension (VisualStudio.Extensibility model,
       preserved from the documented design). Builds only on Windows with the VS extension
       workload; not compiled on this macOS host. Embeds the digest-verified win32-x64 Engine
       Host SEA at EngineHost/ (INV-21/22). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Gaep.VisualStudio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.8.*" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gaep.HostClient\Gaep.HostClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Windows lane builds the win32-x64 SEA, stages it into an out-of-source directory (a `bin`
         path, excluded from source identity), and passes that path as GaepEngineHostDir. The files
         are linked into EngineHost/ inside the VSIX so EngineHostLocator finds the digest-verified
         runtime; nothing generated is committed to source (INV-21/22). -->
    <Content Include="$(GaepEngineHostDir)\**"
             Link="EngineHost\%(RecursiveDir)%(Filename)%(Extension)"
             IncludeInVSIX="true"
             CopyToOutputDirectory="PreserveNewest"
             Condition="'$(GaepEngineHostDir)' != '' And Exists('$(GaepEngineHostDir)')" />
  </ItemGroup>
</Project>
