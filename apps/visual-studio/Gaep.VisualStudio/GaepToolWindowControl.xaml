<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
          Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="1" Padding="10" Margin="0,0,0,12">
          <TextBlock Text="{Binding GovernanceBoundary}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Workspace folder" FontWeight="SemiBold" />
        <TextBox Text="{Binding WorkspacePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,8"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="RefreshProductButton" Content="Refresh Product"
                Command="{Binding RefreshProductCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="ShowPhaseDashboardButton" Content="Show Phase 0/1A dashboards"
                Command="{Binding ShowPhaseDashboardCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Governed Initiative entry" FontWeight="SemiBold" />
        <TextBlock Text="Load one exact Initiative and its Product-bound entry assessment. Classification and applicability are explicit human-authored records: absence never means not applicable, and no result grants approval, readiness, implementation, execution, or release authority."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Exact Initiative UUID" />
        <TextBox Text="{Binding InitiativeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="LoadInitiativeEntryButton" Content="Load exact Initiative entry"
                Command="{Binding LoadInitiativeEntryCommand}" MinHeight="28" Margin="0,0,0,6"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadSourceGovernanceButton" Content="Inspect Source governance"
                Command="{Binding LoadSourceGovernanceCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBusinessUnderstandingButton" Content="Inspect governed Business Understanding"
                Command="{Binding LoadBusinessUnderstandingCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBusinessCapabilityMapButton" Content="Inspect governed Business Capability Map"
                Command="{Binding LoadBusinessCapabilityMapCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadValueStreamModelButton" Content="Inspect governed Value Stream Model"
                Command="{Binding LoadValueStreamModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadOperatingModelButton" Content="Inspect governed Operating Model"
                Command="{Binding LoadOperatingModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBusinessRulesButton" Content="Inspect governed Business Rules"
                Command="{Binding LoadBusinessRulesCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBusinessArchitectureBaselineButton" Content="Inspect governed Business Architecture Baseline"
                Command="{Binding LoadBusinessArchitectureBaselineCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadSystemSolutionArchitectureButton" Content="Inspect governed System/Solution Architecture"
                Command="{Binding LoadSystemSolutionArchitectureCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBoundedContextModelButton" Content="Inspect governed Bounded Context and Ownership"
                Command="{Binding LoadBoundedContextModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadSecurityPrivacyAssessmentButton" Content="Inspect governed Security, Privacy, and Threat Assessment"
                Command="{Binding LoadSecurityPrivacyAssessmentCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadProcessModelButton" Content="Inspect governed Process Model"
                Command="{Binding LoadProcessModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDataModelButton" Content="Inspect governed Data Model"
                Command="{Binding LoadDataModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadAuthorizationModelButton" Content="Inspect governed Authorization Model"
                Command="{Binding LoadAuthorizationModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadEventIntegrationModelButton" Content="Inspect governed Event and Integration Model"
                Command="{Binding LoadEventIntegrationModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadFailureRecoveryModelButton" Content="Inspect governed Failure and Recovery Model"
                Command="{Binding LoadFailureRecoveryModelCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadArchitectureChallengeModelButton" Content="Inspect governed Architecture Challenge"
                Command="{Binding LoadArchitectureChallengeModelCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate coverage and gaps only; it does not complete independent review, establish assurance, accept risk, approve architecture, establish readiness, or authorize action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDecisionRegisterButton" Content="Inspect governed Decision Register"
                Command="{Binding LoadDecisionRegisterCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate counts and gaps only; it does not establish decision effectiveness, approval, risk acceptance, baseline promotion, readiness, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadRiskRegisterButton" Content="Inspect governed Risk Register"
                Command="{Binding LoadRiskRegisterCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate counts and gaps only; it does not establish assessment fact, owner assignment, control effectiveness, risk acceptance, approval, exception, baseline promotion, readiness, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Initiative classification" FontWeight="SemiBold" />
        <TextBlock Text="Primary type" />
        <ComboBox ItemsSource="{Binding InitiativeTypes}"
                  SelectedItem="{Binding InitiativeClassification.PrimaryType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Secondary types (comma-separated canonical values)" />
        <TextBox Text="{Binding InitiativeClassification.SecondaryTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="System state" />
        <ComboBox ItemsSource="{Binding InitiativeSystemStates}"
                  SelectedItem="{Binding InitiativeClassification.SystemState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Change posture" />
        <ComboBox ItemsSource="{Binding InitiativeChangePostures}"
                  SelectedItem="{Binding InitiativeClassification.ChangePosture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Motivations (comma-separated: business-driven, technical, regulatory, operational, security-driven, mixed)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeClassification.Motivations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="User-interface characteristic" />
        <ComboBox ItemsSource="{Binding InitiativeUiStates}"
                  SelectedItem="{Binding InitiativeClassification.UserInterface, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Data characteristic" />
        <ComboBox ItemsSource="{Binding InitiativeDataStates}"
                  SelectedItem="{Binding InitiativeClassification.Data, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Integration characteristic" />
        <ComboBox ItemsSource="{Binding InitiativeIntegrationStates}"
                  SelectedItem="{Binding InitiativeClassification.Integration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Interaction modes (comma-separated: synchronous, asynchronous, batch, streaming, interactive, mixed)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeClassification.InteractionModes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Exposure" />
        <ComboBox ItemsSource="{Binding InitiativeExposures}"
                  SelectedItem="{Binding InitiativeClassification.Exposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Regulated" />
        <ComboBox ItemsSource="{Binding InitiativeBooleanChoices}"
                  SelectedItem="{Binding InitiativeClassification.Regulated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Policy domains (comma-separated portable identifiers)" />
        <TextBox Text="{Binding InitiativeClassification.PolicyDomains, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Sensitivities (comma-separated: security, privacy, data, safety, financial, operational, none, unknown)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeClassification.Sensitivities, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Expected lifetime" />
        <ComboBox ItemsSource="{Binding InitiativeLifetimes}"
                  SelectedItem="{Binding InitiativeClassification.ExpectedLifetime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Maintenance horizon" />
        <TextBox Text="{Binding InitiativeClassification.MaintenanceHorizon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Risk blast radius" />
        <ComboBox ItemsSource="{Binding InitiativeBlastRadii}"
                  SelectedItem="{Binding InitiativeClassification.BlastRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Risk reversibility" />
        <ComboBox ItemsSource="{Binding InitiativeReversibilities}"
                  SelectedItem="{Binding InitiativeClassification.Reversibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Risk urgency" />
        <ComboBox ItemsSource="{Binding InitiativeUrgencies}"
                  SelectedItem="{Binding InitiativeClassification.Urgency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Risk cost of failure" />
        <ComboBox ItemsSource="{Binding InitiativeFailureCosts}"
                  SelectedItem="{Binding InitiativeClassification.CostOfFailure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Dependencies (comma-separated portable descriptions)" />
        <TextBox Text="{Binding InitiativeClassification.Dependencies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Affected assets (comma-separated portable descriptions)" />
        <TextBox Text="{Binding InitiativeClassification.AffectedAssets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Owner" />
        <TextBox Text="{Binding InitiativeClassification.Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Accountable authority" />
        <TextBox Text="{Binding InitiativeClassification.AccountableAuthority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Confidence level" />
        <ComboBox ItemsSource="{Binding InitiativeConfidenceLevels}"
                  SelectedItem="{Binding InitiativeClassification.ConfidenceLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Confidence basis" />
        <TextBox Text="{Binding InitiativeClassification.ConfidenceBasis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Evidence sources (one per line: kind | portable reference | optional sha256 digest)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeClassification.Evidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="60" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Unresolved questions (comma-separated explicit questions)" />
        <TextBox Text="{Binding InitiativeClassification.UnresolvedQuestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Classification rationale" />
        <TextBox Text="{Binding InitiativeClassification.Rationale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="60" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="ClassifyInitiativeButton" Content="Classify or reclassify exact Initiative"
                Command="{Binding ClassifyInitiativeCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Applicability matrix draft" FontWeight="SemiBold" />
        <TextBlock Text="Add every explicit decision and every unresolved subject to a local draft. The draft changes no governed state until the final cancel-default resolution command." TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Decision subject type" />
        <ComboBox ItemsSource="{Binding InitiativeSubjectTypes}"
                  SelectedItem="{Binding InitiativeDecision.SubjectType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Decision subject key (portable identifier)" />
        <TextBox Text="{Binding InitiativeDecision.SubjectKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Decision subject label" />
        <TextBox Text="{Binding InitiativeDecision.SubjectLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Applicability status" />
        <ComboBox ItemsSource="{Binding InitiativeApplicabilityStatuses}"
                  SelectedItem="{Binding InitiativeDecision.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Decision rationale" />
        <TextBox Text="{Binding InitiativeDecision.Rationale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="60" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Decision sources (one per line: kind | portable reference | optional sha256 digest)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeDecision.Sources, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="60" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Decision owner" />
        <TextBox Text="{Binding InitiativeDecision.Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Optional accountable approver" />
        <TextBox Text="{Binding InitiativeDecision.AccountableApprover, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Dependencies (comma-separated portable identifiers)" />
        <TextBox Text="{Binding InitiativeDecision.Dependencies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Conditions (required for deferred, conditionally-required, or blocked)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeDecision.Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Review triggers (comma-separated; at least one)" />
        <TextBox Text="{Binding InitiativeDecision.ReviewTriggers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Approval state" />
        <ComboBox ItemsSource="{Binding InitiativeApprovalStates}"
                  SelectedItem="{Binding InitiativeDecision.ApprovalState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Approval conditions (comma-separated; approved/rejected is attributed to the current human actor and time)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeDecision.ApprovalConditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Related records (one per line: record type | UUID | revision | sha256 digest; required for reused/already-satisfied)" TextWrapping="Wrap" />
        <TextBox Text="{Binding InitiativeDecision.RelatedRecords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="60" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Related implementation units (comma-separated portable identifiers)" />
        <TextBox Text="{Binding InitiativeDecision.RelatedImplementationUnits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="AddInitiativeDecisionButton" Content="Add exact decision to local draft"
                Command="{Binding AddInitiativeDecisionCommand}" MinHeight="28" Margin="0,0,0,10"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Explicit unresolved subject" FontWeight="SemiBold" />
        <TextBlock Text="Unresolved subject type" />
        <ComboBox ItemsSource="{Binding InitiativeSubjectTypes}"
                  SelectedItem="{Binding InitiativeUnresolved.SubjectType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Unresolved subject key" />
        <TextBox Text="{Binding InitiativeUnresolved.SubjectKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Unresolved subject label" />
        <TextBox Text="{Binding InitiativeUnresolved.SubjectLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Unresolved reason" />
        <TextBox Text="{Binding InitiativeUnresolved.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Unresolved owner" />
        <TextBox Text="{Binding InitiativeUnresolved.Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="AddInitiativeUnresolvedButton" Content="Add unresolved subject to local draft"
                Command="{Binding AddInitiativeUnresolvedCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="{Binding InitiativeDraftSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button x:Name="ClearInitiativeDraftButton" Content="Clear local applicability draft"
                Command="{Binding ClearInitiativeDraftCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="ResolveInitiativeApplicabilityButton" Content="Resolve or re-resolve exact applicability"
                Command="{Binding ResolveInitiativeApplicabilityCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Change and impact" FontWeight="SemiBold" />
        <TextBlock Text="Load exact current Change metadata, select one bound revision, then open a read-only projection. Selection grants no Change approval, Risk acceptance, mutation, Run, Tool, write, or effect authority."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <Button x:Name="LoadChangeImpactButton" Content="Load exact current Changes"
                Command="{Binding LoadChangeImpactCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Exact current Change" />
        <ComboBox ItemsSource="{Binding AvailableChangeChoices}"
                  SelectedItem="{Binding SelectedChangeChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <Button x:Name="ShowChangeImpactButton" Content="Show exact Change and impact"
                Command="{Binding ShowChangeImpactCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Agent and model" FontWeight="SemiBold" />
        <TextBlock Text="Show an exact Product-, capability-, and selection-bound metadata projection. It cannot select or switch an agent, create a handoff, launch a Run, authorize effects, establish readiness, or invent provider usage or cost."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <Button x:Name="ShowAgentModelButton" Content="Show exact Agent and model"
                Command="{Binding ShowAgentModelCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Accessible dashboard tables" FontWeight="SemiBold" />
        <TextBlock Text="Load strict Phase, Change/Impact, or Agent/Model metadata, then sort and filter only visible bounded columns. Rendering states exact visible, omitted, and source totals. CSV preparation writes no file and includes no hidden or omitted data."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Dashboard table group" />
        <ComboBox ItemsSource="{Binding AccessibleDashboardGroups}"
                  SelectedItem="{Binding SelectedAccessibleDashboardGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <Button x:Name="LoadAccessibleTablesButton" Content="Load exact accessible dashboard tables"
                Command="{Binding LoadAccessibleTablesCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Verified table" />
        <ComboBox ItemsSource="{Binding AvailableAccessibleTables}"
                  SelectedItem="{Binding SelectedAccessibleTable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Sort column" />
        <ComboBox ItemsSource="{Binding AvailableAccessibleSortColumns}"
                  SelectedItem="{Binding SelectedAccessibleSortColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Sort direction" />
        <ComboBox ItemsSource="{Binding AccessibleSortDirections}"
                  SelectedItem="{Binding SelectedAccessibleSortDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Optional visible-metadata filter (maximum 256 characters)" />
        <TextBox Text="{Binding AccessibleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="256" MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="RenderAccessibleTableButton" Content="Render accessible table and prepare visible CSV"
                Command="{Binding RenderAccessibleTableCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Visible-row CSV (formula-neutralized; no file is written)" />
        <TextBox x:Name="AccessibleCsvTextBox" Text="{Binding AccessibleCsv, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="GAEP visible-row CSV" MinHeight="80" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button Content="1. Select all visible-row CSV"
                Command="{x:Static input:ApplicationCommands.SelectAll}"
                CommandTarget="{Binding ElementName=AccessibleCsvTextBox}" MinHeight="28" Margin="0,0,0,6"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button Content="2. Copy visible rows as CSV"
                Command="{x:Static input:ApplicationCommands.Copy}"
                CommandTarget="{Binding ElementName=AccessibleCsvTextBox}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <Button x:Name="RefreshAgentReadinessButton" Content="Refresh Codex and Claude readiness"
                Command="{Binding RefreshAgentReadinessCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Guarded Agent Selection" FontWeight="SemiBold" />
        <TextBlock Text="Load verified local choices, review only non-sensitive portable settings, then confirm. Selection does not start a provider or grant Run, tool, or effect authority."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <Button x:Name="LoadAgentSelectionButton" Content="Load guarded selection options"
                Command="{Binding LoadAgentSelectionCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Verified agent adapter" />
        <ComboBox ItemsSource="{Binding AvailableAgentChoices}"
                  SelectedItem="{Binding SelectedAgentChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="26" Margin="0,4,0,6" />
        <TextBlock Text="Model ID" />
        <ComboBox ItemsSource="{Binding AvailableModelIds}"
                  Text="{Binding SelectedModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True" MinHeight="26" Margin="0,4,0,6" />
        <ItemsControl ItemsSource="{Binding AgentSettingInputs}" Margin="0,0,0,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,4">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding InputHint}" TextWrapping="Wrap" FontStyle="Italic" />
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="26" Margin="0,4,0,0"
                         Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="SelectAgentButton" Content="Confirm guarded selection"
                Command="{Binding SelectAgentCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Versioned Agent Handoff" FontWeight="SemiBold" />
        <TextBlock Text="Load the latest terminal Run and exact current selection, choose a changed target above, then preserve portable history. A handoff records continuity only; it does not execute an agent or create a Run."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <Button x:Name="LoadAgentHandoffButton" Content="Load versioned handoff context"
                Command="{Binding LoadAgentHandoffCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Handoff reason" />
        <TextBox Text="{Binding HandoffReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Completed work (comma-separated portable entries)" />
        <TextBox Text="{Binding HandoffCompletedWork, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Unresolved matters (comma-separated portable entries)" />
        <TextBox Text="{Binding HandoffUnresolvedMatters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Decisions (comma-separated portable entries)" />
        <TextBox Text="{Binding HandoffDecisions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Evidence (comma-separated workspace-relative references)" />
        <TextBox Text="{Binding HandoffEvidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="CreateAgentHandoffButton" Content="Create versioned handoff"
                Command="{Binding CreateAgentHandoffCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Managed Read-Only Execution" FontWeight="SemiBold" />
        <TextBlock Text="Load an exact confirmed managed Charter and its bound Workflow Plan, review every digest and gate, then attest through a separate cancel-default command. Every Tool remains denied and only observation is allowed."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Exact Execution Charter UUID" />
        <TextBox Text="{Binding ManagedCharterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <TextBlock Text="Exact Workflow Plan UUID" />
        <TextBox Text="{Binding ManagedWorkflowPlanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="LoadManagedReadOnlyPreviewButton" Content="Load exact managed read-only preview"
                Command="{Binding LoadManagedReadOnlyPreviewCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="ExecuteManagedReadOnlyButton" Content="Attest exact preview and run"
                Command="{Binding ExecuteManagedReadOnlyCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Managed Run Evidence" FontWeight="SemiBold" />
        <TextBlock Text="Browse bounded audit-gated Run pages under the first page's exact snapshot digest and total, or read one exact private-safe evidence detail. Navigation cannot start, resume, cancel, apply, discard, or approve work."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <Button x:Name="ListManagedEvidenceButton" Content="Load first Managed Run evidence page"
                Command="{Binding ListManagedEvidenceCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="PreviousManagedEvidencePageButton" Content="Previous verified evidence page"
                Command="{Binding PreviousManagedEvidencePageCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="NextManagedEvidencePageButton" Content="Next verified evidence page"
                Command="{Binding NextManagedEvidencePageCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Exact Managed Run UUID" />
        <TextBox Text="{Binding ManagedRunId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="ReadManagedEvidenceButton" Content="Read Managed Run evidence"
                Command="{Binding ReadManagedEvidenceCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Exact Staged Managed Run Review" FontWeight="SemiBold" />
        <TextBlock Text="Load one exact pending codex-staged review, inspect the complete bounded changed-file inventory and write envelope, then choose apply or discard. Each decision requires two cancel-default confirmations. Post-apply Workflow gates remain not assessed and persisted state does not prove cleanup."
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Exact pending Managed Run UUID" />
        <TextBox Text="{Binding ManagedReviewRunId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="LoadManagedReviewButton" Content="Load exact staged review"
                Command="{Binding LoadManagedReviewCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="ApplyManagedReviewButton" Content="Apply exact reviewed inventory"
                Command="{Binding ApplyManagedReviewCommand}" MinHeight="28" Margin="0,0,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="DiscardManagedReviewButton" Content="Discard exact staged review"
                Command="{Binding DiscardManagedReviewCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Portable design metadata" FontWeight="SemiBold" />
        <Button x:Name="ListDesignImportsButton" Content="List design imports"
                Command="{Binding ListDesignImportsCommand}" MinHeight="28" Margin="0,4,0,8"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <TextBlock Text="Exact bundle UUID" />
        <TextBox Text="{Binding BundleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="ReadDesignImportButton" Content="Read design import"
                Command="{Binding ReadDesignImportCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="Local portable-design bundle folder" />
        <TextBox Text="{Binding BundlePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="26" Margin="0,4,0,6"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        <Button x:Name="ImportDesignBundleButton" Content="Import local bundle as pending review"
                Command="{Binding ImportDesignBundleCommand}" MinHeight="28" Margin="0,0,0,12"
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />

        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="260"
                 Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
  <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Busy}" Value="True">
      <Setter TargetName="RefreshProductButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ShowPhaseDashboardButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadInitiativeEntryButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ClassifyInitiativeButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="AddInitiativeDecisionButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="AddInitiativeUnresolvedButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ClearInitiativeDraftButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ResolveInitiativeApplicabilityButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadAccessibleTablesButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="RenderAccessibleTableButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadChangeImpactButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ShowChangeImpactButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="RefreshAgentReadinessButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadAgentSelectionButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="SelectAgentButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadAgentHandoffButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="CreateAgentHandoffButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadManagedReadOnlyPreviewButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ExecuteManagedReadOnlyButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ListManagedEvidenceButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="PreviousManagedEvidencePageButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="NextManagedEvidencePageButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ReadManagedEvidenceButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="LoadManagedReviewButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ApplyManagedReviewButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="DiscardManagedReviewButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ListDesignImportsButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ReadDesignImportButton" Property="IsEnabled" Value="False" />
      <Setter TargetName="ImportDesignBundleButton" Property="IsEnabled" Value="False" />
    </DataTrigger>
  </DataTemplate.Triggers>
</DataTemplate>
