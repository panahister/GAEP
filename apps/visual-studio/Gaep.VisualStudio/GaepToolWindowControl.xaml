                Command="{Binding LoadImplementationUnitModelCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, and membership, placement, assessment-receipt, and snapshot digests only; it withholds unit titles, boundaries, Story, Task, Requirement, repository, module, owner, evidence, rationale, personal, local-path, secret, and credential content, and does not establish repository truth, ownership appointment, dependency or impact completeness, implementation readiness or completeness, assignment, execution, approval, acceptance, merge, release, deployment, or action authority."
