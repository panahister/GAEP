<!-- GAEP-P0-CS02 — remote UI for the GAEP Provider/Model Tool Window. Buttons issue protocol-v3
     calls over the shared Engine Host; the text area shows the raw governed payload. -->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Extensibility.UI.Styles;assembly=Microsoft.VisualStudio.Extensibility.UI">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Status}" Margin="0,0,0,8" />

        <!-- Real inputs: provider/model chosen by the user (not hardcoded); at least one governed
             Context Pack ID and an objective are required before an analysis can start. -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider (adapterId): " />
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding AdapterId, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model: " />
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ModelId, Mode=TwoWay}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Context Pack IDs (comma-separated): " />
            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding ContextPackIds, Mode=TwoWay}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Objective: " />
            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Objective, Mode=TwoWay}" />
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="Dashboard" Command="{Binding Dashboard}" Margin="0,0,6,6" />
            <Button Content="Provider catalog" Command="{Binding ProviderCatalog}" Margin="0,0,6,6" />
            <Button Content="Select provider/model" Command="{Binding SelectProviderModel}" Margin="0,0,6,6" />
            <Button Content="Start analysis" Command="{Binding StartAnalysis}" Margin="0,0,6,6" />
            <Button Content="Refresh run" Command="{Binding RefreshRun}" Margin="0,0,6,6" />
            <Button Content="Cancel run" Command="{Binding CancelRun}" Margin="0,0,6,6" />
        </WrapPanel>

        <TextBox Grid.Row="3" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True" FontFamily="Consolas" />
    </Grid>
</DataTemplate>
