<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
          Padding="20">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,16" />
      <Border BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"
              BorderThickness="1" Padding="12" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Local engine boundary" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="{Binding EngineBoundary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Limitation}" TextWrapping="Wrap" FontStyle="Italic" />
    </StackPanel>
  </Border>
</DataTemplate>
