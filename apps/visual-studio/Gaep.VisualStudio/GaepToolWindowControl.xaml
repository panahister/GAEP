        <Button x:Name="LoadP0P4ReadinessGateButton" Content="Inspect governed P0-P4 Readiness Gate"
                Command="{Binding LoadP0P4ReadinessGateCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows a bounded candidate evaluation result and gap counts only; a passing gate is not permission and does not grant approval, accept a waiver, authorize phase entry or implementation, establish readiness, or authorize action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadP5HandoffPackageButton" Content="Inspect governed P5 Handoff Package"
                Command="{Binding LoadP5HandoffPackageCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate counts, states, and digests only; source ownership remains retained and complete for review does not establish acknowledgement, approval, a Design Baseline, P5 entry, transfer authority, write authority, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDesignApplicabilityButton" Content="Inspect governed Design Applicability"
                Command="{Binding LoadDesignApplicabilityCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate scope, decision, gap, state, and digest metadata only; silence is never not applicable and this does not approve design, establish a Design Baseline, grant readiness, authorize implementation, write, or action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDesignPersonaRoleButton" Content="Inspect governed Design Personas and Roles"
                Command="{Binding LoadDesignPersonaRoleCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded persona, role, evidence-state, gap, and digest metadata only; it withholds persona content, behaviors, constraints, Source content, personal data, and does not validate personas, appoint roles, verify competence, approve design, establish readiness, or authorize write or action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadUserJourneyButton" Content="Inspect governed User Journeys"
                Command="{Binding LoadUserJourneyCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded journey, touchpoint, path, scope, gap, state, and digest metadata only; it withholds journey steps, touchpoint content, personas, Source content, personal data, and does not prove observed behavior, validate journeys, approve design, establish readiness, or authorize write or action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadInformationArchitectureButton" Content="Inspect governed Information Architecture"
                Command="{Binding LoadInformationArchitectureCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded node, root, route, scope, gap, state, and digest metadata only; it withholds node, route, content, persona, Source, and personal content, and does not prove findability, comprehension, or accessibility, validate content, approve design, establish readiness, or authorize write or action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadScreenStateInventoryButton" Content="Inspect governed Screen and State Inventory"
                Command="{Binding LoadScreenStateInventoryCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded platform, screen, state, variant, route, scope, gap, review state, and digest metadata only; it withholds screen, state, variant, route, content, persona, Source, and personal content, and does not prove UI completeness, platform parity, state reachability, interaction quality, or accessibility, approve design, establish readiness, or authorize write or action."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDesignRequirementsButton" Content="Inspect governed Design Requirements"
                Command="{Binding LoadDesignRequirementsCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, and digests only; it withholds requirement, outcome, Work Item, design target, Source, and personal content, and does not establish requirement validity, completeness, priority approval, satisfaction, backlog commitment, design approval, readiness, implementation, write, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadBacklogHierarchyButton" Content="Inspect governed Backlog Hierarchy"
                Command="{Binding LoadBacklogHierarchyCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, hierarchy counts, statuses, gaps, and digests only; it withholds backlog objectives, criteria, scope, owners, Requirement content, personal data, local paths, secrets, and credentials, and does not establish priority, commitment, ready or done, implementation readiness, assignment, execution, implementation authority, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadMvpSliceDefinitionButton" Content="Inspect governed MVP and Vertical Slices"
                Command="{Binding LoadMvpSliceDefinitionCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, scope and slice counts, statuses, gaps, and exact digests only; it withholds slice titles, rationales, objectives, criteria, scope content, Requirement content, personal data, local paths, secrets, and credentials, and does not establish priority, commitment, scope approval, acceptance-criteria validity, ready or done, implementation readiness, assignment, execution, implementation authority, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadPrioritizationModelButton" Content="Inspect governed Prioritization Model"
                Command="{Binding LoadPrioritizationModelCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, method, membership, ranking, and snapshot digests only; it withholds dimension estimates, evidence identities, uncertainty, slice content, personal data, local paths, secrets, and credentials, and does not establish evidence validity, priority, commitment, scope decisions, approval, readiness, assignment, execution, implementation authority, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadAcceptanceCriteriaButton" Content="Inspect governed Acceptance Criteria"
                Command="{Binding LoadAcceptanceCriteriaCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, and subject, criterion, method, coverage, and snapshot digests only; it withholds criterion text, Requirement identities, verification evidence, personal data, local paths, secrets, and credentials, and does not establish criterion validity, completeness, Requirement satisfaction, priority, commitment, approval, readiness, assignment, execution, acceptance, implementation authority, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDefinitionOfReadyButton" Content="Inspect governed Definition of Ready"
                Command="{Binding LoadDefinitionOfReadyCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, validity time, and subject, policy, evaluation, receipt, and snapshot digests only; it withholds rules, rationales, evidence and assessor identities, personal data, local paths, secrets, and credentials. A candidate pass is not admission, readiness, assignment, execution, implementation permission, exception or waiver authority, phase entry, acceptance, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
        <Button x:Name="LoadDefinitionOfDoneButton" Content="Inspect governed Definition of Done"
                Command="{Binding LoadDefinitionOfDoneCommand}" MinHeight="28" Margin="0,0,0,10"
                AutomationProperties.HelpText="Shows bounded candidate identities, counts, statuses, validity time, and subject, policy, evaluation, receipt, and snapshot digests only; it withholds rules, rationales, evidence and assessor identities, personal data, local paths, secrets, and credentials. A candidate pass does not establish evidence truth, test success, quality, Requirement or Acceptance Criteria satisfaction, approval, ready or done, exception or waiver authority, implementation completeness, merge, release, deployment, assignment, execution, acceptance, or action authority."
                Style="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
