{
  "name": "@gaep/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/design-import",
    "packages/agent-sdk",
    "packages/engine",
    "packages/adapters/*",
    "apps/engine-host",
    "apps/vscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run validate:docs",
    "check:founder": "npm run check && npm run test:vscode:extension-host",
    "clean": "npm run clean --workspaces --if-present",
    "package:vscode": "npm run package -w gaep-vscode",
    "test": "vitest run",
    "test:vscode:extension-host": "npm run test:extension-host -w gaep-vscode",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "validate:docs": "ruby scripts/validate_next_docs.rb"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
