{
  "name": "@gaep/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/agent-sdk",
    "packages/engine",
    "packages/conformance",
    "packages/adapters/*",
    "apps/engine-host",
    "apps/vscode",
    "apps/kiro"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run validate:docs",
    "check:founder": "npm run check && npm run test:vscode:extension-host",
    "clean": "npm run clean --workspaces --if-present",
    "conformance:phase0": "npm run build -w @gaep/conformance",
    "evidence:vscode": "node examples/phase0-readiness/emit-vscode-observation.mjs",
    "example:phase0": "node examples/phase0-readiness/run.mjs",
    "test:lifecycle": "ruby scripts/test/lifecycle_consistency_test.rb",
    "package:vscode": "npm run package -w gaep-vscode",
    "test": "vitest run",
    "test:vscode:extension-host": "npm run test:extension-host -w gaep-vscode",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "validate:docs": "ruby scripts/validate_next_docs.rb",
    "release:cs02": "node scripts/build_cs02_release.mjs",
    "example:cs02": "node examples/phase0-provider-model/run.mjs",
    "evidence:cs02": "node examples/phase0-provider-model/run.mjs --verify",
    "verify:cs02:packages": "node scripts/verify_cs02_packages.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
